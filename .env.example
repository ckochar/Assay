# Server-only Azure AI Document Intelligence credentials.
# Never prefix these variables with VITE_ or expose them to the browser.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=<secret-key>

# Optional overrides. These defaults are used when omitted.
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
AZURE_DOCUMENT_INTELLIGENCE_MODEL_ID=prebuilt-layout
